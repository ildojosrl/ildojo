---
import BaseLayout from "../layouts/BaseLayout.astro";
import eventi from "../data/events.json";
import EventCard from "../components/EventCard.astro";
---

<BaseLayout title="Eventi" description="Scopri gli eventi in programma">
    <section class="max-w-7xl mx-auto py-16 px-4">
        <h1 class="text-4xl md:text-5xl font-bold mb-2">Eventi</h1>
        <p class="text-gray-400 mb-12">
            Rimani aggiornato sulle attività e gli eventi in programma.
        </p>
        <div>
            <p>Cerca gli eventi tramite i siti ufficiali:</p>
            <div class="mb-8 mt-2 flex flex-wrap gap-4">
                <button
                    class="bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 px-4 rounded-full text-lg transition shadow-lg shadow-blue-600/30 mb-4"
                >
                    <a
                        href="https://www.bandai-tcg-plus.com/event?organizer_id=17328&organizer_name=IL%20DOJO%20"
                        target="_blank"
                        rel="noopener noreferrer">One Piece</a
                    >
                </button>
                <button
                    class="bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 px-4 rounded-full text-lg transition shadow-lg shadow-blue-600/30 mb-4"
                >
                    <a
                        href="https://locator.wizards.com/search?query=Dolzago&searchType=magic-events&sortBy=date&sortDirection=Asc&distance=10&page=1&pageSize=10&storeId=21691"
                        target="_blank"
                        rel="noopener noreferrer">Magic</a
                    >
                </button> 
                <button
                    class="bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 px-4 rounded-full text-lg transition shadow-lg shadow-blue-600/30 mb-4"
                >
                    <a
                        href="https://events.pokemon.com/EventLocator/LocationDetail?EventDetailGUID=&LocationName=IL+DOJO+SRL&LocationGuid=3cf354ca-0d04-4302-bced-4c07fab39949&latitude=45.76571&iskm=false&locale=it-IT&storename=IL+DOJO+SRL&range=25&longitude=9.3399565&startdate=2026-10-02"
                        target="_blank"
                        rel="noopener noreferrer">Pokemon</a
                    >
                </button>
                <button
                    class="bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 px-4 rounded-full text-lg transition shadow-lg shadow-blue-600/30 mb-4"
                >
                    <!-- <img
                        src="https://locator.riftbound.uvsgames.com/riftbound-logo.svg"
                        alt="Riftbound Logo"
                        class="inline-block h-5 mr-2"
                    /> -->
                    <a
                        href="https://locator.riftbound.uvsgames.com/stores/ff87eb66-722b-4b05-aa4a-557e345b0147"
                        target="_blank"
                        rel="noopener noreferrer">Riftbound</a
                    >
                </button> 
                <button
                    class="bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2 px-4 rounded-full text-lg transition shadow-lg shadow-blue-600/30 mb-4"
                >
                    <!-- <img
                        src="https://locator.riftbound.uvsgames.com/riftbound-logo.svg"
                        alt="Riftbound Logo"
                        class="inline-block h-5 mr-2"
                    /> -->
                    <a
                        href="https://playriftbound.com/it-IT/events?q=Via+Corsica%2C+43%2C+23843+Dolzago+LC%2C+Italia&lat=45.7656813&lng=9.3400743"
                        target="_blank"
                        rel="noopener noreferrer">Riftbound PostRadiance</a
                    >
                </button>
            </div>

            <div
                class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
            >
                {eventi.map((evento) => <EventCard event={evento} />)}
            </div>
        </div>
    </section></BaseLayout
>
